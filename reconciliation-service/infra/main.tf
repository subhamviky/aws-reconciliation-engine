# reconciliation-service — AWS service landing zone (generated by A2C IaCAgent).
# Serverless compute (Lambda) behind an HTTP API, an SQS work queue with a
# dead-letter queue, a Secrets Manager secret (value set out of band) and
# CloudWatch logs. Environment-specific values are variables; no secrets here.

terraform {
  required_version = ">= 1.7"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
}

provider "aws" {
  region = var.region
}

variable "region" {
  type        = string
  description = "AWS region."
  default     = "ap-south-1"
}

variable "environment" {
  type        = string
  description = "Deployment environment name (dev, test, prod)."
  default     = "dev"
}

variable "lambda_package" {
  type        = string
  description = "Path to the deployment zip built by CI."
  default     = "build/lambda.zip"
}

variable "lambda_handler" {
  type        = string
  description = "Python handler for the API and queue entry points."
  default     = "reconciliation_service.lambda_entry.handler"
}

variable "max_receive_count" {
  type        = number
  description = "Deliveries before a message moves to the dead-letter queue."
  default     = 5
}

variable "setting_settlement_api_url" {
  type        = string
  description = "Base URL of the settlement-service event feed."
  default     = "http://settlement-service.internal:8080"
}

variable "setting_recon_tenant" {
  type        = string
  description = "Tenant whose settlements this deployment reconciles."
  default     = "acme"
}

locals {
  name = "reconciliation-service-${var.environment}"
  tags = {
    project     = "reconciliation-service"
    environment = var.environment
    managed_by  = "terraform"
  }
}

# ---------------------------------------------------------------- messaging
resource "aws_sqs_queue" "dlq" {
  name                      = "${local.name}-dlq"
  message_retention_seconds = 1209600
  tags                      = local.tags
}

resource "aws_sqs_queue" "main" {
  name                       = local.name
  visibility_timeout_seconds = 60
  redrive_policy = jsonencode({
    deadLetterTargetArn = aws_sqs_queue.dlq.arn
    maxReceiveCount     = var.max_receive_count
  })
  tags = local.tags
}

# ------------------------------------------------------------------ secrets
resource "aws_secretsmanager_secret" "app" {
  name                    = "${local.name}/app"
  recovery_window_in_days = 7
  tags                    = local.tags
}

# ------------------------------------------------------------ observability
resource "aws_cloudwatch_log_group" "app" {
  name              = "/aws/lambda/${local.name}"
  retention_in_days = 14
  tags              = local.tags
}

# ---------------------------------------------------------------- identity
data "aws_iam_policy_document" "assume" {
  statement {
    actions = ["sts:AssumeRole"]
    principals {
      type        = "Service"
      identifiers = ["lambda.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "app" {
  name               = "${local.name}-role"
  assume_role_policy = data.aws_iam_policy_document.assume.json
  tags               = local.tags
}

data "aws_iam_policy_document" "app" {
  statement {
    sid       = "Queue"
    actions   = ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes", "sqs:SendMessage", "sqs:GetQueueUrl"]
    resources = [aws_sqs_queue.main.arn]
  }
  # E2A's IdempotentConsumer (v1.7.2): a line that can never succeed is sent to the DLQ with the
  # reason, and the schedule reconciles the DLQ (reads, then deletes what it settled)
  statement {
    sid       = "DeadLetters"
    actions   = ["sqs:SendMessage", "sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueUrl", "sqs:GetQueueAttributes"]
    resources = [aws_sqs_queue.dlq.arn]
  }
  statement {
    sid       = "Logs"
    actions   = ["logs:CreateLogStream", "logs:PutLogEvents"]
    resources = ["${aws_cloudwatch_log_group.app.arn}:*"]
  }
  statement {
    sid       = "Secret"
    actions   = ["secretsmanager:GetSecretValue"]
    resources = [aws_secretsmanager_secret.app.arn]
  }
}

resource "aws_iam_role_policy" "app" {
  name   = "${local.name}-policy"
  role   = aws_iam_role.app.id
  policy = data.aws_iam_policy_document.app.json
}

# ------------------------------------------------------------------ compute
resource "aws_lambda_function" "app" {
  function_name = local.name
  filename      = var.lambda_package
  handler       = var.lambda_handler
  runtime       = "python3.12"
  role          = aws_iam_role.app.arn
  timeout       = 30
  memory_size   = 256
  environment {
    variables = {
      QUEUE_URL   = aws_sqs_queue.main.url
      SECRET_ARN  = aws_secretsmanager_secret.app.arn
      ENVIRONMENT = var.environment

      TABLE_NAME         = aws_dynamodb_table.recon.name
      SETTLEMENT_API_URL = var.setting_settlement_api_url
      RECON_TENANT       = var.setting_recon_tenant
    }
  }
  depends_on = [aws_cloudwatch_log_group.app]
  tags       = local.tags
}

resource "aws_lambda_event_source_mapping" "queue" {
  event_source_arn        = aws_sqs_queue.main.arn
  function_name           = aws_lambda_function.app.arn
  batch_size              = 10
  function_response_types = ["ReportBatchItemFailures"]
}

# --------------------------------------------------------------- exposure
resource "aws_apigatewayv2_api" "http" {
  name          = "${local.name}-api"
  protocol_type = "HTTP"
  tags          = local.tags
}

resource "aws_apigatewayv2_integration" "app" {
  api_id                 = aws_apigatewayv2_api.http.id
  integration_type       = "AWS_PROXY"
  integration_uri        = aws_lambda_function.app.invoke_arn
  payload_format_version = "2.0"
}

resource "aws_apigatewayv2_route" "proxy" {
  api_id    = aws_apigatewayv2_api.http.id
  route_key = "ANY /{proxy+}"
  target    = "integrations/${aws_apigatewayv2_integration.app.id}"
}

resource "aws_apigatewayv2_stage" "default" {
  api_id      = aws_apigatewayv2_api.http.id
  name        = "$default"
  auto_deploy = true
  tags        = local.tags
}

resource "aws_lambda_permission" "api" {
  statement_id  = "AllowHttpApi"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.app.function_name
  principal     = "apigateway.amazonaws.com"
  source_arn    = "${aws_apigatewayv2_api.http.execution_arn}/*/*"
}

output "api_endpoint" {
  value = aws_apigatewayv2_api.http.api_endpoint
}

output "queue_url" {
  value = aws_sqs_queue.main.url
}

output "dlq_url" {
  value = aws_sqs_queue.dlq.url
}
