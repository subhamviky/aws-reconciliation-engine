# Application
APP_NAME=reconciliation-service
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# Cloud Platform (aws)
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=reconciliation-service

# E2A Framework NFRs
MIN_CONFIDENCE=0.85
MAX_LATENCY=2.0
MAX_TOKENS=5000
TOOL_TIMEOUT=5.0
TOOL_RETRIES=3

# App settings (declared in the A2C request)
TABLE_NAME=
SETTLEMENT_API_URL=http://settlement-service.internal:8080
RECON_TENANT=acme
