# Google Cloud binding of reconciliation-service (hub design note GCP-01). PLACEHOLDERS until the
# account exists: filled at cutover. Nothing secret belongs here (keys live in Secret Manager), which is
# why it is .vars and not .env (the repository ignores *.env). infra/gcp reads these as TF_VAR_*.
GCP_PROJECT_ID=finance-ai-landscape-PLACEHOLDER
GCP_REGION=us-central1
# image pushed by CI to the landscape's Artifact Registry (infra/foundation of enterprise-finance-genai-assistant)
RECON_IMAGE=us-central1-docker.pkg.dev/finance-ai-landscape-PLACEHOLDER/landscape/reconciliation-service:latest
SETTLEMENT_API_URL=https://settlement-service-PLACEHOLDER.us-central1.run.app
# simulated (no key) or gemini_api (free tier; the key in Secret Manager under this id)
E2A_PROVIDER_PROFILE=simulated
GEMINI_API_KEY_SECRET=
LLM_MODEL_ID=
# who else may call the service (comma-separated): the assistant's and O2C's service accounts
INVOKER_MEMBERS=serviceAccount:genai-app@finance-ai-landscape-PLACEHOLDER.iam.gserviceaccount.com,serviceAccount:o2c-app@finance-ai-landscape-PLACEHOLDER.iam.gserviceaccount.com
